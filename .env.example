# Copy to .env and fill in. .env is git-ignored; never commit real values.

# dev | test | prod
TRACEFORGE_ENV=dev
# Postgres host as seen from the backend (localhost when the API runs on your machine)
TRACEFORGE_DB_HOST=localhost
# Host port for Postgres; change it if 5432 is already used on your laptop
TRACEFORGE_DB_PORT=5432
# Database name
TRACEFORGE_DB_NAME=
# Database user
TRACEFORGE_DB_USER=
# Database password (any local value; used by both Compose and the backend)
TRACEFORGE_DB_PASSWORD=
