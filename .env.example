# Copy to .env and fill in. .env is git-ignored; never commit real values.

# dev | test | prod
TRACEFORGE_ENV=dev
# Postgres host as seen from the backend (localhost when the API runs on your machine)
TRACEFORGE_DB_HOST=localhost
# Host port for Postgres; change it if 5432 is already used on your laptop
TRACEFORGE_DB_PORT=5432
# Database name
TRACEFORGE_DB_NAME=
# Database user
TRACEFORGE_DB_USER=
# Database password (any local value; used by both Compose and the backend)
TRACEFORGE_DB_PASSWORD=

# LLM gateway: ollama | openrouter | mistral | groq
TRACEFORGE_LLM_PROVIDER=
# Model id (openrouter ids must end with :free while FREE_ONLY is true)
TRACEFORGE_LLM_MODEL=
# Refuse paid or non-allowlisted providers (true/false)
TRACEFORGE_LLM_FREE_ONLY=
TRACEFORGE_OPENROUTER_API_KEY=
TRACEFORGE_MISTRAL_API_KEY=
TRACEFORGE_GROQ_API_KEY=

# GitHub intake: optional read-only token; JSON list of allowed owners or owner/repo
TRACEFORGE_GITHUB_TOKEN=
TRACEFORGE_GITHUB_ALLOWED_OWNERS=
TRACEFORGE_GITHUB_API_BASE=
TRACEFORGE_GITHUB_TIMEOUT_S=
TRACEFORGE_SHOWCASE_MODE=
TRACEFORGE_LLM_ALLOW_OLLAMA_CLOUD=

# --- LLM gateway tuning (all optional; defaults are in backend/traceforge/config.py) ---
# Ollama OpenAI-compatible endpoint (local server)
TRACEFORGE_OLLAMA_BASE_URL=
# JSON list of providers allowed while FREE_ONLY is true, e.g. ["ollama","openrouter"]
TRACEFORGE_LLM_FREE_ALLOWLIST=
# Max output tokens per call (reasoning models spend part of this on hidden reasoning)
TRACEFORGE_LLM_MAX_OUTPUT_TOKENS=
# On-disk response cache and call log locations
TRACEFORGE_LLM_CACHE_DIR=
TRACEFORGE_LLM_CALL_LOG=
# Client-side rate limit (requests per second) and prompt size guard (characters)
TRACEFORGE_LLM_MAX_RPS=
TRACEFORGE_LLM_MAX_PROMPT_CHARS=
# Agent context budget per prompt (characters)
TRACEFORGE_AGENT_CONTEXT_BUDGET_CHARS=

# --- Evaluation ---
# Dataset manifest used by GET /evaluation/report, e.g. datasets/manifests/dev.json
TRACEFORGE_MANIFEST=
# Folder holding saved experiment runs (read by the API and the runner)
TRACEFORGE_RUNS_DIR=

# Lab has its own env: see lab/.env.example (LAB_* names)
