# Copy to lab/.env and fill in. lab/.env is git-ignored. The lab has its own Postgres, separate from TraceForge's.
# Lab Postgres database name
LAB_DB_NAME=
# Lab Postgres user
LAB_DB_USER=
# Lab Postgres password (any local value)
LAB_DB_PASSWORD=
# Host loopback port for the shop API
LAB_API_PORT=8100
# Host loopback port for the lab Redis (used by probes)
LAB_REDIS_PORT=6380
